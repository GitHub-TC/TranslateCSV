<Window x:Class="TranslateCSV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslateCSV 2.0 – Empyrion Übersetzungstool"
        Width="780" Height="720" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="Label" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6,6,6,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200" MinHeight="160"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ SPRACHUMSCHALTER ═══════════════ -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,4" LastChildFill="False">
                <TextBlock x:Name="LangLabelText" DockPanel.Dock="Left"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           FontWeight="SemiBold" Text="🌐 Sprache:"/>
                <ComboBox x:Name="UILanguageBox" DockPanel.Dock="Left"
                          Width="160" VerticalAlignment="Center"
                          SelectionChanged="UILanguageBox_SelectionChanged">
                    <ComboBoxItem Tag="de">🇩🇪  Deutsch</ComboBoxItem>
                    <ComboBoxItem Tag="en">🇬🇧  English</ComboBoxItem>
                    <ComboBoxItem Tag="fr">🇫🇷  Français</ComboBoxItem>
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- ═══════════════ TABS ═══════════════ -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="4,4,4,0" FontWeight="Normal">

            <!-- ──── Tab 1: API & Sprachen ──── -->
            <TabItem x:Name="TabItem_Api" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox x:Name="Group_ApiKey">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="Lbl_ApiKey" Style="{StaticResource Label}" Grid.Column="0"/>
                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="ApiKeyBox" Padding="4,3" VerticalAlignment="Center"
                                                     PasswordChanged="ApiKeyBox_PasswordChanged"/>
                                        <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed"
                                                 TextChanged="ApiKeyTextBox_TextChanged"/>
                                    </Grid>
                                    <ToggleButton x:Name="ShowKeyToggle" Grid.Column="2"
                                                  Width="32" Margin="4,4,0,4" Padding="0" FontSize="14"
                                                  Content="👁"
                                                  Checked="ShowKeyToggle_Checked"
                                                  Unchecked="ShowKeyToggle_Unchecked"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="170,2,0,4">
                                    <RadioButton x:Name="FreeKeyRadio"
                                                 IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="ProKeyRadio" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="Hint_ApiUrl" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="Group_Languages">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label x:Name="Lbl_SourceLang" Style="{StaticResource Label}" Grid.Row="0"/>
                                <TextBox x:Name="CsvSourceLanguageBox" Grid.Row="0" Grid.Column="1"/>

                                <Label x:Name="Lbl_TargetLang" Style="{StaticResource Label}" Grid.Row="1"/>
                                <TextBox x:Name="CsvTargetLanguageBox" Grid.Row="1" Grid.Column="1"/>

                                <Label x:Name="Lbl_DeepLCode" Style="{StaticResource Label}" Grid.Row="2"/>
                                <ComboBox x:Name="DeepLTargetLanguageBox" Grid.Row="2" Grid.Column="1"
                                          IsEditable="True" Margin="0,4" Padding="4,3" VerticalContentAlignment="Center"/>

                                <TextBlock x:Name="Hint_LangCodes" Grid.Row="3" Grid.Column="1"
                                           Style="{StaticResource Hint}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──── Tab 2: Dateien ──── -->
            <TabItem x:Name="TabItem_Files" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox x:Name="Group_CsvFiles">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label x:Name="Lbl_InputFile" Style="{StaticResource Label}" Grid.Row="0"
                                       Foreground="DarkRed"/>
                                <TextBox x:Name="CsvInputBox" Grid.Row="0" Grid.Column="1"/>
                                <Button x:Name="BrowseCsvInputBtn" Style="{StaticResource BrowseButton}"
                                        Grid.Row="0" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvInput_Click"/>

                                <Label x:Name="Lbl_OutputFile" Style="{StaticResource Label}" Grid.Row="1"/>
                                <TextBox x:Name="CsvOutputBox" Grid.Row="1" Grid.Column="1"/>
                                <Button x:Name="BrowseCsvOutputBtn" Style="{StaticResource BrowseButton}"
                                        Grid.Row="1" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvOutput_Click"/>

                                <Label x:Name="Lbl_RefFile" Style="{StaticResource Label}" Grid.Row="2"/>
                                <TextBox x:Name="CsvRefBox" Grid.Row="2" Grid.Column="1"/>
                                <Button x:Name="BrowseCsvRefBtn" Style="{StaticResource BrowseButton}"
                                        Grid.Row="2" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvRef_Click"/>

                                <TextBlock x:Name="Hint_Files" Grid.Row="3" Grid.Column="1"
                                           Style="{StaticResource Hint}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="Group_HelperFiles">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label x:Name="Lbl_ProtectWords" Style="{StaticResource Label}" Grid.Row="0"/>
                                <TextBox x:Name="ProtectWordsBox" Grid.Row="0" Grid.Column="1"/>
                                <Button x:Name="BrowseProtectWordsBtn" Style="{StaticResource BrowseButton}"
                                        Grid.Row="0" Grid.Column="2"
                                        Content="📂" Click="BrowseProtectWords_Click"/>

                                <Label x:Name="Lbl_Glossar" Style="{StaticResource Label}" Grid.Row="1"/>
                                <TextBox x:Name="GlossarBox" Grid.Row="1" Grid.Column="1"/>
                                <Button x:Name="BrowseGlossarBtn" Style="{StaticResource BrowseButton}"
                                        Grid.Row="1" Grid.Column="2"
                                        Content="📂" Click="BrowseGlossar_Click"/>

                                <TextBlock x:Name="Hint_HelperFiles" Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource Hint}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──── Tab 3: Erweitert ──── -->
            <TabItem x:Name="TabItem_Advanced" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox x:Name="Group_Advanced">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label x:Name="Lbl_NewTranslate" Style="{StaticResource Label}" Grid.Row="0"/>
                                <CheckBox x:Name="NewTranslateCheck" Grid.Row="0" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="0,8"/>

                                <Label x:Name="Lbl_MaxTranslations" Style="{StaticResource Label}" Grid.Row="1"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="LimitTranslationsBox" Width="80" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="Hint_Unlimited" VerticalAlignment="Center"
                                               Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                                </StackPanel>

                                <Label x:Name="Lbl_ParallelCalls" Style="{StaticResource Label}" Grid.Row="2"/>
                                <TextBox x:Name="MaxParallelCallsBox" Grid.Row="2" Grid.Column="1"
                                         Width="80" HorizontalAlignment="Left"/>

                                <TextBlock x:Name="Hint_Advanced" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ TRENNLINIE ═══════════════ -->
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                      Background="#CCC" ShowsPreview="True" Cursor="SizeNS"/>

        <!-- ═══════════════ AKTIONSBEREICH ═══════════════ -->
        <Grid Grid.Row="3" Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton" Grid.Column="0"
                        FontSize="13" FontWeight="SemiBold"
                        Padding="16,7" Margin="0,0,8,0"
                        Background="#FF388E3C" Foreground="White"
                        Click="StartButton_Click"/>

                <Button x:Name="CancelButton" Grid.Column="1"
                        FontSize="13" Padding="12,7" IsEnabled="False"
                        Background="#FFD32F2F" Foreground="White"
                        Click="CancelButton_Click"/>

                <ProgressBar x:Name="ProgressBar" Grid.Column="2"
                             Height="22" Margin="10,0"
                             Minimum="0" Visibility="Collapsed"/>

                <TextBlock x:Name="StatusText" Grid.Column="3"
                           VerticalAlignment="Center"
                           FontSize="12" Foreground="#555" Margin="4,0"/>
            </Grid>

            <GroupBox x:Name="Group_Log" Grid.Row="1" Padding="4" Margin="0">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="#1E1E1E" Foreground="#DCDCDC"
                         BorderThickness="0" Padding="4"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
