<Window x:Class="TranslateCSV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslateCSV 2.0 – Empyrion Übersetzungstool"
        Width="780" Height="700" MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Einheitliche Label-Breite über alle Tabs -->
        <Style x:Key="Label" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6,6,6,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Margin" Value="4,4,0,4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ToolTip" Value="Datei auswählen"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200" MinHeight="160"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ TABS ═══════════════ -->
        <TabControl Grid.Row="0" Margin="4,4,4,0" FontWeight="Normal">

            <!-- ──── Tab 1: API & Sprachen ──── -->
            <TabItem Header="🔑  API &amp; Sprachen" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="DeepL API-Schlüssel">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Style="{StaticResource Label}" Grid.Column="0"
                                           Content="API-Schlüssel:"
                                           ToolTip="Dein persönlicher DeepL API-Schlüssel. Kostenlos registrieren unter deepl.com/pro#developer"/>
                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="ApiKeyBox" Padding="4,3" VerticalAlignment="Center"
                                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                                     ToolTip="Gib hier deinen DeepL API-Schlüssel ein"/>
                                        <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed"
                                                 TextChanged="ApiKeyTextBox_TextChanged"
                                                 ToolTip="API-Schlüssel (sichtbar)"/>
                                    </Grid>
                                    <ToggleButton x:Name="ShowKeyToggle" Grid.Column="2"
                                                  Width="32" Margin="4,4,0,4" Padding="0" FontSize="14"
                                                  Content="👁" ToolTip="Schlüssel anzeigen / verbergen"
                                                  Checked="ShowKeyToggle_Checked"
                                                  Unchecked="ShowKeyToggle_Unchecked"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="170,2,0,4">
                                    <RadioButton x:Name="FreeKeyRadio" Content="Free-Account (kostenlos, endet auf ':fx')"
                                                 IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"
                                                 ToolTip="Kostenloser DeepL-Account: bis 500.000 Zeichen pro Monat gratis"/>
                                    <RadioButton x:Name="ProKeyRadio" Content="Pro-Account (kostenpflichtig)"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Kostenpflichtiger DeepL Pro-Account ohne Zeichenlimit"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="💡 Kostenlosen API-Schlüssel erstellen: https://www.deepl.com/pro#developer  (500.000 Zeichen/Monat gratis)"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Spracheinstellungen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Style="{StaticResource Label}" Grid.Row="0"
                                       Content="Quellsprache (CSV):"
                                       ToolTip="Spaltenname in der CSV-Datei für die Originalsprache, z.B. 'English'"/>
                                <TextBox x:Name="CsvSourceLanguageBox" Grid.Row="0" Grid.Column="1"/>

                                <Label Style="{StaticResource Label}" Grid.Row="1"
                                       Content="Zielsprache (CSV):"
                                       ToolTip="Spaltenname in der CSV-Datei für die Übersetzung, z.B. 'Deutsch'"/>
                                <TextBox x:Name="CsvTargetLanguageBox" Grid.Row="1" Grid.Column="1"/>

                                <Label Style="{StaticResource Label}" Grid.Row="2"
                                       Content="DeepL-Sprachcode:"
                                       ToolTip="Sprachkürzel für die DeepL API. Aus der Liste wählen oder direkt eingeben."/>
                                <ComboBox x:Name="DeepLTargetLanguageBox" Grid.Row="2" Grid.Column="1"
                                          IsEditable="True" Margin="0,4" Padding="4,3" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="Beispiel: DE = Deutsch, FR = Französisch, ES = Spanisch, IT = Italienisch, RU = Russisch"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──── Tab 2: Dateien ──── -->
            <TabItem Header="📁  Dateien" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="CSV-Dateien">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Style="{StaticResource Label}" Grid.Row="0" Foreground="DarkRed"
                                       Content="Eingabedatei  *:"
                                       ToolTip="Pflichtfeld: Die CSV-Datei mit den zu übersetzenden Texten"/>
                                <TextBox x:Name="CsvInputBox" Grid.Row="0" Grid.Column="1"/>
                                <Button Style="{StaticResource BrowseButton}" Grid.Row="0" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvInput_Click"/>

                                <Label Style="{StaticResource Label}" Grid.Row="1"
                                       Content="Ausgabedatei:"
                                       ToolTip="Optional: Zieldatei für das Ergebnis. Leer lassen = Eingabedatei wird überschrieben."/>
                                <TextBox x:Name="CsvOutputBox" Grid.Row="1" Grid.Column="1"/>
                                <Button Style="{StaticResource BrowseButton}" Grid.Row="1" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvOutput_Click"/>

                                <Label Style="{StaticResource Label}" Grid.Row="2"
                                       Content="Referenzdatei:"
                                       ToolTip="Optional: Alte CSV-Datei als Referenz – bereits übersetzte Texte werden direkt übernommen statt neu zu übersetzen."/>
                                <TextBox x:Name="CsvRefBox" Grid.Row="2" Grid.Column="1"/>
                                <Button Style="{StaticResource BrowseButton}" Grid.Row="2" Grid.Column="2"
                                        Content="📂" Click="BrowseCsvRef_Click"/>

                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="* = Pflichtfeld  |  Ausgabedatei leer lassen, um die Eingabedatei direkt zu aktualisieren"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Hilfsdateien">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Style="{StaticResource Label}" Grid.Row="0"
                                       Content="Schutzwörter-Datei:"
                                       ToolTip="Textdatei mit regulären Ausdrücken für Wörter/Muster, die NICHT übersetzt werden sollen (z.B. Spielbefehle wie @w4, {PlayerName})"/>
                                <TextBox x:Name="ProtectWordsBox" Grid.Row="0" Grid.Column="1"/>
                                <Button Style="{StaticResource BrowseButton}" Grid.Row="0" Grid.Column="2"
                                        Content="📂" Click="BrowseProtectWords_Click"/>

                                <Label Style="{StaticResource Label}" Grid.Row="1"
                                       Content="Glossar-Datei:"
                                       ToolTip="CSV-Datei mit manuellen Übersetzungen für spielspezifische Begriffe (werden bevorzugt behandelt)"/>
                                <TextBox x:Name="GlossarBox" Grid.Row="1" Grid.Column="1"/>
                                <Button Style="{StaticResource BrowseButton}" Grid.Row="1" Grid.Column="2"
                                        Content="📂" Click="BrowseGlossar_Click"/>

                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="Diese Dateien liegen standardmäßig im Programmordner. Leer lassen = Standarddatei verwenden."/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──── Tab 3: Erweitert ──── -->
            <TabItem Header="⚙  Erweitert" FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Übersetzungsoptionen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Style="{StaticResource Label}" Grid.Row="0"
                                       Content="Alles neu übersetzen:"
                                       ToolTip="Übersetzt alle Einträge neu, auch wenn bereits eine Übersetzung vorhanden ist"/>
                                <CheckBox x:Name="NewTranslateCheck" Grid.Row="0" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="0,8"/>

                                <Label Style="{StaticResource Label}" Grid.Row="1"
                                       Content="Max. Übersetzungen:"
                                       ToolTip="Maximale Anzahl zu übersetzender Einträge. 0 = unbegrenzt. Nützlich zum Testen der Einstellungen."/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="LimitTranslationsBox" Width="80" HorizontalAlignment="Left"/>
                                    <TextBlock Text="(0 = unbegrenzt)" VerticalAlignment="Center"
                                               Style="{StaticResource Hint}" Margin="8,0,0,0"/>
                                </StackPanel>

                                <Label Style="{StaticResource Label}" Grid.Row="2"
                                       Content="Parallele Aufrufe:"
                                       ToolTip="Anzahl gleichzeitiger DeepL-API-Aufrufe. Mehr = schneller, aber höhere API-Last. Standard: 8"/>
                                <TextBox x:Name="MaxParallelCallsBox" Grid.Row="2" Grid.Column="1"
                                         Width="80" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="💡 Tipp zum Testen: Setze 'Max. Übersetzungen' auf 5 und prüfe das Ergebnis, bevor du alles übersetzt."/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════ TRENNLINIE ═══════════════ -->
        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                      Background="#CCC" ShowsPreview="True" Cursor="SizeNS"/>

        <!-- ═══════════════ AKTIONSBEREICH ═══════════════ -->
        <Grid Grid.Row="2" Margin="6,4,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Buttons + Fortschritt -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton" Grid.Column="0"
                        Content="▶  Übersetzung starten" FontSize="13" FontWeight="SemiBold"
                        Padding="16,7" Margin="0,0,8,0"
                        Background="#FF388E3C" Foreground="White"
                        Click="StartButton_Click"
                        ToolTip="Übersetzung mit den aktuellen Einstellungen starten"/>

                <Button x:Name="CancelButton" Grid.Column="1"
                        Content="✕  Abbrechen" FontSize="13"
                        Padding="12,7" IsEnabled="False"
                        Background="#FFD32F2F" Foreground="White"
                        Click="CancelButton_Click"
                        ToolTip="Laufende Übersetzung abbrechen"/>

                <ProgressBar x:Name="ProgressBar" Grid.Column="2"
                             Height="22" Margin="10,0"
                             Minimum="0" Visibility="Collapsed"/>

                <TextBlock x:Name="StatusText" Grid.Column="3"
                           Text="Bereit" VerticalAlignment="Center"
                           FontSize="12" Foreground="#555" Margin="4,0"/>
            </Grid>

            <!-- Protokoll-Box -->
            <GroupBox Grid.Row="1" Header="Protokoll" Padding="4" Margin="0">
                <TextBox x:Name="LogBox"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="#1E1E1E" Foreground="#DCDCDC"
                         BorderThickness="0" Padding="4"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
