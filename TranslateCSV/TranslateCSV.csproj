<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Description>Translation for Empyrion CSV files</Description>
		<Copyright>ASTIC/TC Copyright © 2023</Copyright>
		<Authors>ASTIC/TC</Authors>
		<PackageReleaseNotes>GNU General Public License v3.0</PackageReleaseNotes>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<!-- Self-contained publish defaults (used by Standalone.pubxml and dotnet publish) -->
	<PropertyGroup Condition="'$(PublishProfile)' == 'Standalone' Or '$(RuntimeIdentifier)' != ''">
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>true</PublishReadyToRun>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="GlossarWords.csv" />
		<None Remove="ProtectWords.txt" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="GlossarWords.csv">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="ProtectWords.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.0.1" />
	</ItemGroup>

	<!-- Nach dem Publish: TranslateCSV.zip im Publish-Verzeichnis erstellen -->
	<Target Name="ZipAfterPublish" AfterTargets="Publish">
		<PropertyGroup>
			<ZipPath>$(PublishDir)..\TranslateCSV.zip</ZipPath>
		</PropertyGroup>
		<Message Text="Erstelle $(ZipPath) ..." Importance="high" />
		<ZipDirectory SourceDirectory="$(PublishDir)"
		              DestinationFile="$(ZipPath)"
		              Overwrite="true" />
		<Message Text="✔ TranslateCSV.zip erstellt: $(ZipPath)" Importance="high" />
	</Target>

</Project>
